<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="32dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_sucesso"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/Texto.TituloGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Pedido confirmado!" />

            <TextView
                style="@style/Texto.Suave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Agora é só aguardar. Já estamos preparando tudo!" />

            <!-- Código de entrega em destaque -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_codigo"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Texto.Rotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Código para receber o pedido" />

                <TextView
                    android:id="@+id/tvCodigo"
                    style="@style/Texto.TituloGrande"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.2"
                    android:textColor="@color/primaria"
                    android:textSize="40sp" />

                <TextView
                    style="@style/Texto.Suave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informe este código ao entregador"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Dados de entrega -->
            <LinearLayout
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Texto.Secao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Entrega" />

                <TextView
                    android:id="@+id/tvNome"
                    style="@style/Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_pessoa"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvEndereco"
                    style="@style/Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_local"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvPagamento"
                    style="@style/Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_pagamento"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <!-- Itens e total -->
            <LinearLayout
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Texto.Secao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Itens do pedido" />

                <TextView
                    android:id="@+id/tvItens"
                    style="@style/Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/linha" />

                <TextView
                    android:id="@+id/tvTotal"
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

    </ScrollView>

    <LinearLayout
        style="@style/BarraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <Button
            android:id="@+id/btnAcompanhar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acompanhar pedido" />

        <Button
            android:id="@+id/btnNovoPedido"
            style="@style/Botao.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fazer novo pedido"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</LinearLayout>
