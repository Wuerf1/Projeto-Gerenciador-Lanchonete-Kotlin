<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/Texto.Marca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                style="@style/Texto.TituloGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="O que vai ser hoje?"
                android:layout_marginTop="6dp" />

            <TextView
                style="@style/Texto.Suave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolha um restaurante e monte o seu pedido."
                android:layout_marginTop="4dp" />

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restaurantes"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

            <!-- Água na Boca -->
            <LinearLayout
                android:id="@+id/cardLanchonete"
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/logo_lanchonete"
                    android:contentDescription="Logo Água na Boca" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.NomeItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Água na Boca"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Texto.Suave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lanchonete · Lanches, salgados e bebidas"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Texto.Suave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawableStart="@drawable/ic_relogio"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:textSize="13sp"
                        android:text="30 a 40 min" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_seta"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Sorveteria Borcelle -->
            <LinearLayout
                android:id="@+id/cardSorveteria"
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/logo_sorveteria"
                    android:contentDescription="Logo Sorveteria Borcelle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.NomeItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sorveteria Borcelle"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Texto.Suave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sorveteria · Sorvetes, açaí e picolés"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Texto.Suave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawableStart="@drawable/ic_relogio"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:textSize="13sp"
                        android:text="30 a 40 min" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_seta"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Borcelle Cafeteria -->
            <LinearLayout
                android:id="@+id/cardCafeteria"
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/logo_cafeteria"
                    android:contentDescription="Logo Borcelle Cafeteria" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.NomeItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Borcelle Cafeteria"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Texto.Suave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cafeteria · Cafés, pães e bolos"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Texto.Suave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawableStart="@drawable/ic_relogio"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:textSize="13sp"
                        android:text="30 a 40 min" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_seta"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

    </ScrollView>

    <LinearLayout
        style="@style/BarraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnSobre"
            style="@style/Botao.Secundario"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Sobre" />

        <Button
            android:id="@+id/btnCarrinho"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_marginStart="12dp"
            android:layout_height="wrap_content"
            android:text="Ver carrinho" />
    </LinearLayout>
</LinearLayout>
