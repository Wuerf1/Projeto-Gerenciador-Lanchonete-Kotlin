<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Botões ===== -->
    <style name="Botao.Principal" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/primaria</item>
        <item name="android:textColor">@color/branco</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Botao.Secundario" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primaria</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="backgroundTint">@color/superficie</item>
        <item name="android:textColor">@color/primaria</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Botao.Quantidade" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/primaria_clara</item>
        <item name="android:textColor">@color/primaria</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ===== Textos ===== -->
    <style name="Texto">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Texto.Marca">
        <item name="android:textColor">@color/primaria</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Texto.TituloGrande">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
    <style name="Texto.Titulo">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
    <style name="Texto.Secao">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Texto.NomeItem">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Texto.Suave">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Texto.Preco">
        <item name="android:textColor">@color/primaria</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Texto.Rotulo">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Etiquetas pequenas ("Obrigatório", "Opcional") -->
    <style name="Etiqueta">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/primaria_escura</item>
        <item name="android:background">@drawable/bg_etiqueta</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
    <style name="Etiqueta.Neutra">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:background">@drawable/bg_etiqueta_neutra</item>
    </style>

    <!-- Cartão branco de cantos arredondados -->
    <style name="Cartao">
        <item name="android:background">@drawable/bg_cartao</item>
        <item name="android:elevation">2dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Cartão que pode ser tocado (restaurantes e itens do cardápio) -->
    <style name="Cartao.Clicavel">
        <item name="android:background">@drawable/bg_cartao_clicavel</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Barra fixa de botões no rodapé -->
    <style name="BarraInferior">
        <item name="android:background">@drawable/bg_barra_inferior</item>
        <item name="android:elevation">16dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Opções de sabor e adicionais -->
    <style name="Opcao">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">6dp</item>
    </style>
</resources>
