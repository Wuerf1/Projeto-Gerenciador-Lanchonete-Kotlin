        <activity android:name=".PastelActivity" />

        <activity android:name=".BatataFritaActivity" />

        <activity android:name=".PaoDeQueijoActivity" />

        <activity android:name=".SucoActivity" />

        <activity android:name=".CarrinhoActivity" />

        <activity android:name=".DadosEntregaActivity" />

        <activity android:name=".ComprovanteActivity" />

        <activity android:name=".AcompanhamentoActivity" />

        <activity android:name=".SobreActivity" />

        <activity android:name=".RestaurantesActivity" />

        <activity android:name=".SorveteriaActivity" />

        <activity android:name=".CafeteriaActivity" />

        <activity android:name=".CasquinhaActivity" />

        <activity android:name=".SundaeActivity" />

        <activity android:name=".AcaiActivity" />

        <activity android:name=".PicoleActivity" />

        <activity android:name=".CafeActivity" />

        <activity android:name=".CappuccinoActivity" />

        <activity android:name=".PaoNaChapaActivity" />

        <activity android:name=".BoloActivity" />

    </application>

</manifest>
